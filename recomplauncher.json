{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Krusty's Super Fun House Recomp",
  "repo": "Bentley734/Krustys-Super-Fun-House-PC-Port",
  "game": {
    "kind": "iso",
    "label": "Your Krusty's Super Fun House (USA) (Rev 1) SNES cartridge dump (.sfc or .smc).",
    "dumps": [
      {
        "name": "USA (Rev 1), headerless",
        "size": 524288,
        "crc32": "ac5116d9"
      }
    ]
  },
  "start": {
    "program": [
      "KrustysSuperFunHouseRecomp.exe",
      "Krustys Super Fun House Recomp.app/Contents/MacOS/KrustysSuperFunHouseRecomp"
    ],
    "args": [
      "--no-launcher",
      "--rom",
      "{game}"
    ]
  },
  "prepare": {
    "program": [
      "KrustysSuperFunHouseRecomp.exe",
      "Krustys Super Fun House Recomp.app/Contents/MacOS/KrustysSuperFunHouseRecomp"
    ],
    "args": [
      "--verify-rom",
      "{game}"
    ],
    "label": "Verify the SNES cartridge",
    "timeout": 30
  },
  "config": [
    {
      "format": "ini",
      "file": [
        {
          "path": "{install}/config.ini",
          "if": "{install}/portable.txt"
        },
        {
          "path": "{install}/config.ini",
          "if": "{install}/KrustysSuperFunHouseRecomp.exe"
        },
        {
          "path": "{home}/Library/Application Support/Krustys Super Fun House Recomp/config.ini"
        }
      ],
      "ensure": {
        "Graphics/WindowScale": "3",
        "Graphics/NewRenderer": "1",
        "Graphics/NoSpriteLimits": "1",
        "Sound/AudioFreq": "32000"
      }
    }
  ],
  "settings": [
    {
      "id": "aspect",
      "label": "Aspect ratio",
      "help": "Wide presets reveal more of the loaded room while fixed screens keep their original framing.",
      "choices": [
        {
          "label": "4:3",
          "set": {
            "Graphics/DisplayAspect": "4:3"
          }
        },
        {
          "label": "8:7",
          "set": {
            "Graphics/DisplayAspect": "8:7"
          }
        },
        {
          "label": "1:1",
          "set": {
            "Graphics/DisplayAspect": "1:1"
          }
        },
        {
          "label": "16:9",
          "set": {
            "Graphics/DisplayAspect": "16:9"
          }
        },
        {
          "label": "21:9",
          "set": {
            "Graphics/DisplayAspect": "21:9"
          }
        },
        {
          "label": "32:9",
          "set": {
            "Graphics/DisplayAspect": "32:9"
          }
        }
      ],
      "defaults": {
        "Graphics/DisplayAspect": "4:3"
      }
    },
    {
      "id": "fullscreen",
      "label": "Fullscreen",
      "choices": [
        {
          "label": "Off",
          "set": {
            "Graphics/Fullscreen": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "Graphics/Fullscreen": "1"
          }
        }
      ],
      "defaults": {
        "Graphics/Fullscreen": "0"
      }
    },
    {
      "id": "audio",
      "label": "Game audio",
      "choices": [
        {
          "label": "Off",
          "set": {
            "Sound/EnableAudio": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "Sound/EnableAudio": "1"
          }
        }
      ],
      "defaults": {
        "Sound/EnableAudio": "1"
      }
    },
    {
      "id": "volume",
      "label": "Volume",
      "slider": {
        "key": "Sound/Volume",
        "min": 0,
        "max": 100,
        "step": 5,
        "format": "%d"
      },
      "defaults": {
        "Sound/Volume": "100"
      }
    }
  ],
  "folders": {
    "data": [
      {
        "path": "{install}",
        "if": "{install}/portable.txt"
      },
      {
        "path": "{install}",
        "if": "{install}/KrustysSuperFunHouseRecomp.exe"
      },
      {
        "path": "{home}/Library/Application Support/Krustys Super Fun House Recomp"
      }
    ],
    "logs": [
      {
        "path": "{install}",
        "if": "{install}/portable.txt"
      },
      {
        "path": "{install}",
        "if": "{install}/KrustysSuperFunHouseRecomp.exe"
      },
      {
        "path": "{home}/Library/Application Support/Krustys Super Fun House Recomp"
      }
    ]
  },
  "saves": [
    "{install}/config.ini",
    "{install}/keybinds.ini",
    "{install}/mods/preloaded/state.toml",
    "{home}/Library/Application Support/Krustys Super Fun House Recomp/config.ini",
    "{home}/Library/Application Support/Krustys Super Fun House Recomp/keybinds.ini",
    "{home}/Library/Application Support/Krustys Super Fun House Recomp/mods/preloaded/state.toml"
  ],
  "actions": [
    {
      "id": "data",
      "label": "Open game data folder",
      "help": "Find your settings, controls and latest run report.",
      "open": "data"
    }
  ],
  "exit_codes": {
    "65": "Choose a clean Krusty's Super Fun House (USA) (Rev 1) SNES ROM."
  },
  "looks": {
    "lines": 224
  }
}
